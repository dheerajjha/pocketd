<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Raises the jetsam ceiling from roughly 45% to roughly 58% of physical
	     RAM, which is the difference between a 4B model loading and being
	     killed on a 6 GB device. Requires the Increased Memory Limit
	     capability on the App ID; `make device-install` builds without it. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- HealthKit. The access array is deliberately empty: that is the base
	     capability, and clinical health records are a separate, far broader
	     grant this app has no use for. No background-delivery key either —
	     nothing here observes, and background queries do not run in the
	     Simulator regardless.

	     This is the one entitlement that can break a device build on its own:
	     automatic signing fails unless HealthKit is also enabled on the App ID
	     in the developer portal. Simulator builds are unaffected. -->
	<!-- The shared container a widget reads. A widget extension is a separate
	     process with its own container and can see nothing of this app's without
	     it. Like HealthKit above, this can break a device build on its own:
	     automatic signing fails unless the group is registered on the App ID.
	     `make device-install` builds without it, and `SchedulePublicationStore`
	     treats a missing container as a quiet no — the widget shows its
	     placeholder rather than the app failing to launch. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.pocketd.app</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
